# Wajib. Connection string Neon — hanya dibaca server, tidak pernah
# ter-bundle ke browser karena tidak berawalan VITE_.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Opsional. Kosongkan bila API satu domain dengan frontend (Netlify Function
# di /api/*) — klien memakai jalur relatif /api/v1. Isi hanya bila API
# dipasang di domain terpisah.
# VITE_API_URL="https://api.contoh.id/api/v1"

# Opsional. Origin yang diizinkan bila API berada di domain berbeda.
# Tidak perlu diisi untuk deployment satu domain.
# CORS_ORIGIN="https://lmstia.netlify.app"
